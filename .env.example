DRY_RUN=true

# Dev.to — https://dev.to/settings/extensions
DEVTO_API_KEY=

# Mastodon — create an app under Preferences > Development
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky — Settings > App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Telegram — create a bot via @BotFather, then get chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord — channel settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=
